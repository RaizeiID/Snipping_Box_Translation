*.swp
*.swo

# OS/editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Archives generated locally
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# Keep checksums/docs if manually added
!*_SHA256.txt
!docs/**/*.md
/ORT/runtime_app/runtime_stop_request.json
