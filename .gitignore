# ORT Translation - GitHub Safe Ignore
# Version: v8.8.1 R3
#
# Tujuan:
# - Mencegah runtime lokal, cache, log, backup, model besar, dan file pribadi ikut terupload ke GitHub.
# - Aman bila repo Git dibuat dari root folder ORT_Translation_v8_8_1.

# Root-level local runtime/model folders visible in your screenshot
/models/
/ORT_Runtime/
/cache/
/logs/
/backups/
/debug_bundles/
/status/
/reports/
/.venv/
/venv/
/env/

# GitHub source export generated by helper script
/ORT_GITHUB_SOURCE_EXPORT.zip

# Local runtime / heavy local folder
/ORT/_LOCAL_RUNTIME_WEB_DO_NOT_UPLOAD/

# Embedded/local runtime and environments
/ORT/runtime_app/ORT_Runtime/
/ORT/runtime_app/.venv/
/ORT/runtime_app/venv/
/ORT/runtime_app/env/
/ORT/runtime_app/models/
/ORT/runtime_app/model/
/ORT/runtime_app/engines/models/
/ORT/runtime_app/_runtime/
/ORT/runtime_app/runtime/python/
/ORT/runtime_app/runtime/models/

# Runtime generated data inside runtime_app
/ORT/runtime_app/cache/
/ORT/runtime_app/logs/
/ORT/runtime_app/backups/
/ORT/runtime_app/debug_bundles/
/ORT/runtime_app/status/
/ORT/runtime_app/reports/
/ORT/runtime_app/temp/
/ORT/runtime_app/tmp/

# Project-level generated data
/ORT/cache/
/ORT/logs/
/ORT/backups/
/ORT/debug_bundles/
/ORT/status/
/ORT/reports/
/ORT/temp/
/ORT/tmp/

# User active data / preferences
/ORT/user_data/preferences/
/ORT/user_data/identity/
/ORT/user_data/commander_profiles/
/ORT/user_data/review_queue/
/ORT/runtime_app/speaker_registry_v2.json
/ORT/runtime_app/webui_prefs.json
/ORT/runtime_app/configs/app_state.json
/ORT/runtime_app/data_processing_store*.json
/ORT/runtime_app/data_processing_settings*.json

# Python generated files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs and temporary files
*.log
*.tmp
*.bak
*.old
